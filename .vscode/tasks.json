{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "buildType",
            "type": "pickString",
            "description": "Select build type",
            "options": [
                "Debug",
                "Release"
            ],
            "default": "Debug"
        },
    ],
    "tasks": [
        {
            "label": "Build with Ninja",
            "type": "shell",
            "command": "${workspaceFolder}/build.bat",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Clear and ReBuild",
            "type": "shell",
            "command": "${workspaceFolder}/rebuild.bat",
            "args": ["${input:buildType}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Restart Clangd",
            "type": "shell",
            "command": "${command:clangd.restart}",
            "presentation": {
                "reveal": "silent",
                "close": true
            }
        },
        {
            "label": "ReBuild and Restart Clangd",
            "dependsOrder": "sequence",
            "dependsOn": ["Clear and ReBuild", "Restart Clangd"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}